# Provider credentials. The runners read names only from models.toml and never write values.
# Fill in only the providers you run.

# API keys
ASSEMBLYAI_API_KEY=
CARTESIA_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
META_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=
RESON8_API_KEY=
SMALLEST_API_KEY=
SONIOX_API_KEY=
SPEECHMATICS_API_KEY=
TOGETHER_API_KEY=
XAI_API_KEY=

# Azure AI Speech (mai-transcribe-2, azure-stt-realtime).
# Endpoint: https://RESOURCE_NAME.cognitiveservices.azure.com
AZURE_SPEECH_API_KEY=
AZURE_SPEECH_ENDPOINT=

# Azure AI Foundry deployment of MAI-Transcribe-2-Streaming (mai-transcribe-2-realtime).
# Endpoint: https://RESOURCE_NAME.services.ai.azure.com
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_ENDPOINT=

# Google Cloud Speech-to-Text V2 (chirp_3, chirp_3-realtime) uses Application Default
# Credentials, not an API key. GOOGLE_APPLICATION_CREDENTIALS (a service-account JSON path)
# is optional when using `gcloud auth application-default login`.
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: Hugging Face token for downloading the open models (run_transformers.py).
HF_TOKEN=

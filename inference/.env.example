# Provider credentials. The runner reads names only from models.toml and never writes values.
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
CARTESIA_API_KEY=
OPENAI_API_KEY=
SMALLEST_API_KEY=
AZURE_SPEECH_API_KEY=
AZURE_SPEECH_ENDPOINT=https://RESOURCE_NAME.cognitiveservices.azure.com
HF_TOKEN=
XAI_API_KEY=
META_API_KEY=
RESON8_API_KEY=
GEMINI_API_KEY=
SONIOX_API_KEY=
MISTRAL_API_KEY=

# Google Cloud Speech-to-Text V2 uses Application Default Credentials, not an API key.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
GOOGLE_CLOUD_PROJECT=
AZURE_FOUNDRY_ENDPOINT=https://RESOURCE_NAME.services.ai.azure.com
AZURE_FOUNDRY_API_KEY=
TOGETHER_API_KEY=
